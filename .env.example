# Optional. Everything here can be set on the web page's Settings screen instead,
# and values saved there take priority over this file.

# Long random string. You type it into the web page once on each device.
# Generate one with: openssl rand -base64 24
UPLOAD_TOKEN=

# Your Send to Kindle address (Amazon → Manage Your Content and Devices → Preferences → Personal Document Settings)
KINDLE_EMAIL=you@kindle.com

# Account the books are emailed from. It must be on Amazon's "Approved Personal Document E-mail List".
# Gmail: turn on 2-step verification, then create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# SMTP_FROM defaults to SMTP_USER
# SMTP_FROM=

# Pass/fail emails go here. Defaults to SMTP_USER; set to "none" to turn them off.
# NOTIFY_EMAIL=

# Google Drive folder to watch (optional). The ID is the last part of the folder's URL:
# https://drive.google.com/drive/folders/<THIS PART>
# Put the service account's JSON key at ./config/google-service-account.json (see README).
# DRIVE_FOLDER_ID=
# DRIVE_POLL_SECONDS=60

# Only used by `docker compose run --rm libtokindle activate`. Leave empty for an anonymous activation.
# ADOBE_ID=
# ADOBE_PASSWORD=

# Set to true to keep working files in WORK_DIR for debugging.
# KEEP_FILES=false
